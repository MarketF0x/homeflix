# Configuration Homeflix
# Copiez ce fichier en .env et modifiez les valeurs

# Clé API TMDb (obtenir sur https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your_api_key_here

# Configuration serveur
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Base de données
DATABASE_PATH=./homeflix.db

# Sécurité
MAX_UPLOAD_SIZE=100MB
ALLOWED_ORIGINS=*

# Performance
ENABLE_CACHE=true
CACHE_TTL=3600

# Logs
LOG_LEVEL=INFO
LOG_FILE=homeflix.log
