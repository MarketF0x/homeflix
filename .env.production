# Configuration Production - Homeflix
# Ne pas inclure ce fichier dans le contrôle de version si vous ajoutez des secrets

# Mode de production
NODE_ENV=production

# Désactiver les logs de développement
VITE_DEBUG=false

# URL du serveur backend (modifiable lors de l'installation)
VITE_API_URL=http://localhost:8000

# Configuration de sécurité
VITE_STRICT_MODE=true
